[{"s": 0.0, "e": 1.08, "t": "音乐"}, {"s": 15.08, "e": 21.56, "t": "长夜压在我刀锋之上 五百重甲拦不住一道寒光"}, {"s": 22.28, "e": 28.84, "t": "谁在高处定对错罪状 谁把人命装进天 拼力成亮"}, {"s": 29.5, "e": 32.5, "t": "我殺過噩兔 也放過混帳"}, {"s": 32.5, "e": 36.28, "t": "每次把刀都是我的主張"}, {"s": 36.9, "e": 39.88, "t": "若正義有權是執掌"}, {"s": 39.88, "e": 43.58, "t": "那我寧願做亂世的瘋狂"}, {"s": 44.24, "e": 48.02, "t": "誰陪寫生死不 誰陪划山的狂"}, {"s": 48.02, "e": 50.86, "t": "誰的規矩 又誰來撞葬"}, {"s": 50.86, "e": 55.44, "t": "我不信天 不信命 不信誰的理所應當"}, {"s": 55.44, "e": 58.54, "t": "只行著冰刀還滾頭"}, {"s": 59.28, "e": 62.08, "t": "卸位論道不放"}, {"s": 62.08, "e": 65.58, "t": "誰人來定真寫一方"}, {"s": 65.58, "e": 69.2, "t": "若歸則是天秘同向"}, {"s": 69.2, "e": 73.24, "t": "那就披開他看個天流"}, {"s": 73.92, "e": 76.54, "t": "卸位論不為了"}, {"s": 76.54, "e": 80.36, "t": "是非對錯我自己看"}, {"s": 80.36, "e": 83.94, "t": "天不怕我來聊"}, {"s": 83.94, "e": 86.24, "t": "這一道就是我的回答"}, {"s": 89.02, "e": 92.02, "t": "是人叫我孤純大局退讓"}, {"s": 92.02, "e": 95.84, "t": "可大局背後是誰的權兵在囂張"}, {"s": 95.84, "e": 99.44, "t": "犧牲多少才算夠分量"}, {"s": 99.44, "e": 103.36, "t": "被犧牲的人可曾有機會反抗"}, {"s": 103.36, "e": 105.72, "t": "如今天兵不問傷藏"}, {"s": 106.34, "e": 109.26, "t": "誰的命都我在自己手上"}, {"s": 110.06, "e": 112.46, "t": "若這世道黑白顛倒"}, {"s": 112.46, "e": 117.02, "t": "那就用刀鋒 中心畫出方向"}, {"s": 117.74, "e": 121.4, "t": "誰定好規則誰寫好劇本提到"}, {"s": 121.4, "e": 124.54, "t": "誰的正義成了交易的暗笑"}, {"s": 124.54, "e": 128.74, "t": "我不低頭不忍命不信什麼大局位上"}, {"s": 128.74, "e": 132.28, "t": "信這冰刀 還在發燙"}, {"s": 134.16, "e": 137.06, "t": "寫為了 道不放"}, {"s": 137.06, "e": 140.74, "t": "誰人來定的寫一方"}, {"s": 140.74, "e": 144.32, "t": "若規則是鐵筆同橋"}, {"s": 144.32, "e": 148.48, "t": "那就劈開它 看個天亮"}, {"s": 148.48, "e": 151.9, "t": "血為冷 鼓為涼"}, {"s": 151.9, "e": 155.42, "t": "是非對錯我 自己抗"}, {"s": 155.42, "e": 158.68, "t": "天不叛 我來了"}, {"s": 158.68, "e": 161.38, "t": "這一道就是我的回答"}, {"s": 163.32, "e": 165.86, "t": "什麼叫大局 什麼叫犧牲"}, {"s": 165.86, "e": 168.6, "t": "什麼叫仁讓 什麼叫異議"}, {"s": 168.6, "e": 170.8, "t": "依然还见人力所应当"}, {"s": 170.8, "e": 172.56, "t": "若诚意有你定义"}, {"s": 172.56, "e": 174.44, "t": "谁来定义你的嘴妆"}, {"s": 174.44, "e": 178.16, "t": "谁又来为被牺牲的陪传"}, {"s": 178.16, "e": 180.32, "t": "从今往后我的道"}, {"s": 180.32, "e": 181.86, "t": "只听我主张"}, {"s": 181.86, "e": 183.14, "t": "谁定的规矩"}, {"s": 183.14, "e": 184.68, "t": "我偏要闯"}, {"s": 185.32, "e": 186.68, "t": "天不叛"}, {"s": 187.32, "e": 188.52, "t": "我来叛"}, {"s": 188.52, "e": 192.38, "t": "倒不到我来当"}, {"s": 193.28, "e": 195.66, "t": "卸回了 倒不放"}, {"s": 195.66, "e": 199.56, "t": "時間從來沒有什麼天力照將"}, {"s": 199.56, "e": 202.94, "t": "若規則是謊言偽裝"}, {"s": 202.94, "e": 207.28, "t": "那就撕碎他自己定規章"}, {"s": 207.28, "e": 210.32, "t": "虛偽冷酷偽量"}, {"s": 210.32, "e": 212.34, "t": "對就是對錯就是錯"}, {"s": 212.34, "e": 215.92, "t": "可虛偽裝天不叛"}, {"s": 216.5, "e": 219.5, "t": "我來量這一道就是我的"}, {"s": 219.5, "e": 221.2, "t": "真的早厕"}]